# AI 散策クエスト API（backend）の設定。このファイルをコピーして backend/.env を作る（.env は Git の管理対象外）。
# 秘密情報は backend/.env だけに書く。frontend の .env や VITE_ で始まる変数には絶対に書かない。

# mock = Bedrock を呼ばずに規則で提案する（既定） / bedrock = Amazon Bedrock を呼ぶ（承認後に使う）
AI_PROVIDER=mock

# Bedrock の API キー（秘密情報・ローカル開発だけで使う）。値はチャットやログに貼らない
# 公開版（Vercel）では使わない：Vercel には設定しない（設定されていても無視する）。docs/vercel-ai-setup.md を参照
AWS_BEARER_TOKEN_BEDROCK=

# 公開版（Vercel）だけで使う設定。ローカル開発では空のままにする
# AWS_ROLE_ARN=arn:aws:iam::123456789012:role/ehime-walk-ai-quest
# AI_QUEST_QUOTA_TABLE=ehime-walk-ai-quota

# 使えるのは次の 2 つだけ：jp.amazon.nova-2-lite-v1:0 / jp.anthropic.claude-haiku-5-5
BEDROCK_MODEL_ID=jp.amazon.nova-2-lite-v1:0
BEDROCK_REGION=ap-northeast-1

# 利用制限（サーバー側で必ず守る値。ユーザーの 1 日の上限は 10 を超えられない）
AI_QUEST_USER_DAILY_LIMIT=10
AI_QUEST_GLOBAL_DAILY_LIMIT=200
AI_QUEST_MAX_CONCURRENCY=2
AI_QUEST_CACHE_TTL_SECONDS=600
AI_QUEST_TIMEOUT_MS=20000
AI_QUEST_MAX_TOKENS=800
AI_QUEST_MAX_CANDIDATES=5

# ローカルサーバー
PORT=8787
ALLOWED_ORIGIN=http://localhost:5173
