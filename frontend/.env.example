# 画面の設定の例。このファイルをコピーして .env.development.local（自分の PC で npm run dev するとき）を作る。
# .local で終わるファイルは Git に入らない。VITE_ で始まる値はブラウザに送られるため、秘密情報は絶対に書かない。

# API の実装を切り替える。mock = ブラウザ内のモック（既定） / supabase = Supabase（オンライン）
VITE_API_MODE=mock

# Supabase の公開用の設定（Project Settings → API Keys）。キーは sb_publishable_ で始まるもの
# sb_secret_ で始まるキー（秘密のキー）は、ここにも VITE_ で始まる変数にも絶対に入れない
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# AI 散策クエストの API の場所（任意。未設定なら同じオリジンの /api）
# VITE_AI_API_BASE_URL=
